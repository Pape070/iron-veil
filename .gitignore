# ---------- Unity generated ----------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Never ignore Asset meta data
!/[Aa]ssets/**/*.meta

# Autogenerated VS/Rider/VSCode solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
.idea/
.vscode/

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics / Gradle
crashlytics-build.properties
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------- Local tooling ----------
# .NET test harness output (the rules test project lives in tools/, outside Assets)
tools/**/bin/
tools/**/obj/
tools/packages/
tools/*.log
*.trx
TestResults/

# Local secrets / user env (never commit keys)
.env
*.local.json

# ---------- OS noise ----------
.DS_Store
Thumbs.db
desktop.ini

# Hand-written .NET tool projects are part of the repository (rules tests, balance
# report, syntax check and the input-asset generator all run outside Unity).
!tools/**/*.csproj
